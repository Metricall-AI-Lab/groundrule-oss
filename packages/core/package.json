{
  "name": "@groundrule/core",
  "version": "0.1.0",
  "description": "Groundrule engine: loading, validation, scope resolution, and the evaluator plugin interface.",
  "license": "Apache-2.0",
  "author": "Vyana Compute",
  "homepage": "https://groundrule.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metricall-AI-Lab/groundrule-oss.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Metricall-AI-Lab/groundrule-oss/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@groundrule/spec": "workspace:*",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  }
}
