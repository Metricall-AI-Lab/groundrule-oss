{
  "name": "@groundrule/mcp",
  "version": "0.1.1",
  "description": "A minimal Model Context Protocol server (stdio, tools only) for Groundrule.",
  "license": "Apache-2.0",
  "author": "Vyana Compute",
  "homepage": "https://groundrule.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metricall-AI-Lab/groundrule-oss.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/Metricall-AI-Lab/groundrule-oss/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
