{
  "name": "@groundrule/mcp",
  "version": "0.0.0",
  "description": "A minimal Model Context Protocol server (stdio, tools only) for Groundrule.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
