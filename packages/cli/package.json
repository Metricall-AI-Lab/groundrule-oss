{
  "name": "@groundrule/cli",
  "version": "0.24.0",
  "mcpName": "io.github.Metricall-AI-Lab/groundrule",
  "description": "Groundrule: your engineering standards, taught to every coding agent and checked on every PR. CLI, checks, packs, MCP server and hooks.",
  "license": "Apache-2.0",
  "author": "Vyana Compute",
  "homepage": "https://groundrule.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metricall-AI-Lab/groundrule-oss.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Metricall-AI-Lab/groundrule-oss/issues"
  },
  "type": "module",
  "bin": {
    "groundrule": "./dist/bin.js",
    "gr": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@groundrule/adapters": "workspace:*",
    "@groundrule/core": "workspace:*",
    "@groundrule/evaluators": "workspace:*",
    "@groundrule/mcp": "workspace:*",
    "@groundrule/packs": "workspace:*",
    "@groundrule/reporters": "workspace:*",
    "@groundrule/spec": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "coding-agents",
    "agents-md",
    "claude-code",
    "cursor",
    "github-copilot",
    "mcp",
    "mcp-server",
    "code-quality",
    "engineering-standards",
    "coding-standards",
    "developer-tools",
    "static-analysis",
    "ci"
  ]
}
