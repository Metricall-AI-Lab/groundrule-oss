{
  "name": "@groundrule/packs",
  "version": "0.1.0",
  "description": "Community standard packs for Groundrule.",
  "license": "Apache-2.0",
  "author": "Vyana Compute",
  "homepage": "https://groundrule.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metricall-AI-Lab/groundrule-oss.git",
    "directory": "packages/packs"
  },
  "bugs": {
    "url": "https://github.com/Metricall-AI-Lab/groundrule-oss/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "catalog"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@groundrule/core": "workspace:*",
    "@groundrule/spec": "workspace:*",
    "picomatch": "^4.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@groundrule/evaluators": "workspace:*",
    "@types/picomatch": "^4.0.3",
    "yaml": "^2.9.1"
  }
}
