{
  "name": "@groundrule/spec",
  "version": "0.1.1",
  "description": "The Groundrule specification: schemas and types for standards, packs, config, exceptions, and findings.",
  "license": "Apache-2.0",
  "author": "Vyana Compute",
  "homepage": "https://groundrule.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metricall-AI-Lab/groundrule-oss.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/Metricall-AI-Lab/groundrule-oss/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/generate-json-schema.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
