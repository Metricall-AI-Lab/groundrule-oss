{
  "$id": "https://groundrule.dev/schemas/v1alpha1/finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "standardId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
      "description": "Unique, stable standard identifier, e.g. AUTH-017."
    },
    "standardVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "evaluator": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "deterministic",
        "static-analysis",
        "ai",
        "external"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "violation",
        "concern",
        "pass",
        "not-evaluable"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "advisory",
        "warning",
        "blocker"
      ],
      "description": "info: context only. advisory: non-blocking recommendation. warning: visible, needs acknowledgment. blocker: fails the check."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "certain"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative POSIX path."
        },
        "startLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startColumn": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "endColumn": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "file",
        "startLine"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: what is wrong."
    },
    "evidence": {
      "default": [],
      "description": "Why the evaluator believes this.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remediation": {
      "type": "string",
      "minLength": 1
    },
    "isNew": {
      "type": "boolean",
      "description": "True if introduced by the change under evaluation, false if legacy."
    },
    "suppressedBy": {
      "description": "ID of the exception that suppresses this finding, if any.",
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identity across runs, used for dedupe, baselines, and feedback."
    }
  },
  "required": [
    "standardId",
    "standardVersion",
    "evaluator",
    "source",
    "status",
    "severity",
    "confidence",
    "message",
    "isNew",
    "fingerprint"
  ],
  "additionalProperties": false,
  "description": "The result of evaluating one standard against one location."
}
