{
  "$id": "https://groundrule.dev/schemas/v1alpha1/agent-action.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "groundrule.dev/v1alpha1",
      "description": "Groundrule document format version. Must be \"groundrule.dev/v1alpha1\"."
    },
    "kind": {
      "type": "string",
      "const": "AgentAction"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "generatedAt",
        "cliVersion"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "As registered in Groundrule, e.g. acme/payments-api."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "The agent whose hook ran, lower-cased."
        },
        "via": {
          "type": "string",
          "const": "hook"
        },
        "session": {
          "description": "sha256 of the agent's session id.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "via"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": [
        "shell",
        "edit",
        "read",
        "fetch",
        "mcp",
        "other"
      ],
      "description": "shell: a command. edit: writing a file. read: reading a file. fetch: a web request. mcp: a tool on an MCP server. other: any other tool."
    },
    "decision": {
      "type": "string",
      "enum": [
        "ask",
        "deny"
      ],
      "description": "What the agent was told."
    },
    "policies": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "effect": {
            "type": "string",
            "enum": [
              "allow",
              "ask",
              "deny"
            ],
            "description": "allow: the agent may proceed without a prompt. ask: a person confirms first. deny: refused, with the reason."
          }
        },
        "required": [
          "id",
          "effect"
        ],
        "additionalProperties": false
      },
      "description": "The policies that matched."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "repository",
    "agent",
    "action",
    "decision",
    "policies"
  ],
  "additionalProperties": false
}
