{
  "$id": "https://groundrule.dev/schemas/v1alpha1/check-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "groundrule.dev/v1alpha1",
      "description": "Groundrule document format version. Must be \"groundrule.dev/v1alpha1\"."
    },
    "kind": {
      "type": "string",
      "const": "CheckRun"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "snippets": {
          "type": "boolean",
          "description": "Whether code snippets were included."
        },
        "authorship": {
          "description": "false when --no-authorship left the authorship record out (RFC 0007).",
          "type": "boolean"
        }
      },
      "required": [
        "generatedAt",
        "cliVersion",
        "durationMs",
        "snippets"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "owner/name from the git remote, or the folder name."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "pullRequest": {
      "description": "Present when the run was for a pull request.",
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "url": {
          "description": "The pull request on the code host.",
          "type": "string",
          "maxLength": 500,
          "format": "uri"
        },
        "headRef": {
          "description": "The branch being merged.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "headSha": {
          "description": "The pull request's head commit, where the code host shows checks. CI often checks out a test merge commit instead (repository.commit).",
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "baseRef": {
          "description": "The branch merged into.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "author": {
          "description": "The author's login on the code host.",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "number"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "all",
        "changes"
      ]
    },
    "base": {
      "description": "The ref compared against.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "description": "Files checked."
    },
    "changedFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "passed": {
      "type": "boolean"
    },
    "failOn": {
      "type": "string",
      "enum": [
        "blocker",
        "warning",
        "none"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "standards": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "warned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "notEvaluable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "guidance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "violations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "concerns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "legacy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "blocking": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      },
      "required": [
        "standards",
        "passed",
        "failed",
        "warned",
        "notEvaluable",
        "guidance",
        "skipped",
        "violations",
        "concerns",
        "suppressed",
        "legacy",
        "blocking"
      ],
      "additionalProperties": false
    },
    "outcomes": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "advisory",
              "warning",
              "blocker"
            ],
            "description": "info: context only. advisory: non-blocking recommendation. warning: visible, needs acknowledgment. blocker: fails the check."
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "warned",
              "not-evaluable",
              "guidance",
              "skipped"
            ]
          },
          "violations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "concerns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "version": {
            "description": "The standard's metadata.version when the run used it (RFC 0007).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "digest": {
            "description": "SHA-256 of the standard as applied, after customizations, as canonical JSON (RFC 0007).",
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stage": {
            "description": "The organization's rollout stage for this rule. Absent for rules without a stage.",
            "type": "string",
            "enum": [
              "observe",
              "teach",
              "advise",
              "enforce"
            ]
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "checked",
              "ai-review",
              "guidance"
            ],
            "description": "checked: a deterministic or static-analysis check can fail a change. ai-review: AI checks only, advisory. guidance: no check."
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "violations",
          "concerns"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "standardId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "advisory",
              "warning",
              "blocker"
            ],
            "description": "info: context only. advisory: non-blocking recommendation. warning: visible, needs acknowledgment. blocker: fails the check."
          },
          "status": {
            "type": "string",
            "enum": [
              "violation",
              "concern"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "deterministic",
              "static-analysis",
              "ai",
              "external"
            ]
          },
          "blocking": {
            "type": "boolean",
            "description": "This finding fails the run."
          },
          "isNew": {
            "type": "boolean",
            "description": "Introduced by the change under evaluation, not legacy."
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Repository-relative POSIX path."
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "snippet": {
            "description": "The offending line, credential-shaped values redacted. Omitted with --no-snippets.",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "standardId",
          "severity",
          "status",
          "source",
          "blocking",
          "isNew",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "omittedFindings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000,
      "description": "Findings beyond the 500 sent."
    },
    "rulebook": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 of one line per rule in effect, '<id> <digest> <stage or -> <severity>', sorted by ID."
        },
        "standards": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "description": "Rules in effect: active, not turned off, at any stage but Observe."
        },
        "source": {
          "type": "string",
          "enum": [
            "platform",
            "local"
          ],
          "description": "Rules from a Groundrule workspace, or local files only."
        },
        "platform": {
          "description": "The workspace and when its rulebook was generated, when source is platform.",
          "type": "object",
          "properties": {
            "org": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "generatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "org",
            "generatedAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "digest",
        "standards",
        "source"
      ],
      "additionalProperties": false,
      "description": "Which rules were in effect for the run, verifiably."
    },
    "exceptions": {
      "description": "Exceptions that suppressed at least one finding in this run.",
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EX-[0-9]+$"
          },
          "standard": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "expires": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Calendar date, YYYY-MM-DD."
          },
          "approvedBy": {
            "description": "As written in .groundrule/exceptions.yaml.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "suppressed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Findings it suppressed in this run."
          }
        },
        "required": [
          "id",
          "standard",
          "expires",
          "suppressed"
        ],
        "additionalProperties": false
      }
    },
    "authorship": {
      "type": "object",
      "properties": {
        "commits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "description": "Commits in the change."
        },
        "agents": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "commits": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "name",
              "commits"
            ],
            "additionalProperties": false
          },
          "description": "Each coding agent declared by the commits, most commits first."
        },
        "method": {
          "type": "string",
          "const": "commit-metadata",
          "description": "Detected from commit trailers and bot authors, never from code. A declaration, not proof."
        }
      },
      "required": [
        "commits",
        "agents",
        "method"
      ],
      "additionalProperties": false,
      "description": "Who or what wrote the change, as declared in its commits."
    },
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "ed25519"
            },
            "keyId": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "sha256: of the public key's raw 32 bytes."
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$",
              "description": "The Ed25519 signature of the signing payload, base64."
            }
          },
          "required": [
            "algorithm",
            "keyId",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sigstore"
            },
            "bundle": {
              "type": "object",
              "properties": {
                "mediaType": {
                  "type": "string",
                  "pattern": "^application\\/vnd\\.dev\\.sigstore\\.bundle"
                }
              },
              "required": [
                "mediaType"
              ],
              "additionalProperties": {},
              "description": "The Sigstore bundle: certificate, signature over the payload, and the log entry."
            },
            "identity": {
              "type": "object",
              "properties": {
                "issuer": {
                  "type": "string",
                  "maxLength": 200,
                  "format": "uri",
                  "description": "The OIDC issuer, e.g. GitHub Actions."
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "The signer, e.g. https://github.com/acme/payments/.github/workflows/ci.yml@refs/heads/main."
                }
              },
              "required": [
                "issuer",
                "subject"
              ],
              "additionalProperties": false,
              "description": "The certificate's identity, copied out so readers needn't parse it; verifiers re-derive it."
            }
          },
          "required": [
            "algorithm",
            "bundle",
            "identity"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Proves the run is what its signer produced; verifiable offline."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "repository",
    "mode",
    "files",
    "changedFiles",
    "passed",
    "failOn",
    "summary",
    "outcomes",
    "findings",
    "omittedFindings"
  ],
  "additionalProperties": false,
  "description": "A check run, produced by `groundrule check` and uploaded with --upload."
}
