{
  "$id": "https://groundrule.dev/schemas/v1alpha1/ai-review-requests.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "groundrule.dev/v1alpha1",
      "description": "Groundrule document format version. Must be \"groundrule.dev/v1alpha1\"."
    },
    "kind": {
      "type": "string",
      "const": "AiReviewRequests"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "generatedAt",
        "cliVersion"
      ],
      "additionalProperties": false
    },
    "requests": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "standardId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "standardVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "advisory",
              "warning",
              "blocker"
            ],
            "description": "info: context only. advisory: non-blocking recommendation. warning: visible, needs acknowledgment. blocker: fails the check."
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minConfidence": {
            "type": "string",
            "enum": [
              "medium",
              "high"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "hunks": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startLine": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Line number of the first line below."
                },
                "lines": {
                  "minItems": 1,
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              },
              "required": [
                "startLine",
                "lines"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "standardId",
          "standardVersion",
          "title",
          "requirement",
          "severity",
          "question",
          "minConfidence",
          "file",
          "hunks"
        ],
        "additionalProperties": false
      }
    },
    "skipped": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Files past the per-run limits."
        },
        "standards": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "description": "Rules with an llm check that had something to review but were cut."
        }
      },
      "required": [
        "files",
        "standards"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "requests",
    "skipped"
  ],
  "additionalProperties": false
}
