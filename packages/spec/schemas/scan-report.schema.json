{
  "$id": "https://groundrule.dev/schemas/v1alpha1/scan-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "groundrule.dev/v1alpha1",
      "description": "Groundrule document format version. Must be \"groundrule.dev/v1alpha1\"."
    },
    "kind": {
      "type": "string",
      "const": "ScanReport"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "snippets": {
          "type": "boolean",
          "description": "Whether code snippets were included."
        }
      },
      "required": [
        "generatedAt",
        "cliVersion",
        "durationMs",
        "snippets"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "owner/name from the git remote, or the folder name."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      },
      "required": [
        "name",
        "files"
      ],
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "languages": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "frameworks": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      },
      "required": [
        "languages",
        "frameworks"
      ],
      "additionalProperties": false
    },
    "agentFiles": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Repository-relative POSIX path."
          },
          "kind": {
            "type": "string",
            "enum": [
              "agents-md",
              "claude-md",
              "claude-rules",
              "cursor-rules",
              "cursorrules",
              "copilot-instructions",
              "copilot-path-instructions",
              "gemini-md",
              "windsurf-rules",
              "aider-conventions"
            ]
          },
          "lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Content hash, to notice changes."
          },
          "managed": {
            "type": "boolean",
            "description": "Contains a block written by `groundrule sync`."
          },
          "headings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "bullets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "required": [
          "path",
          "kind",
          "lines",
          "bytes",
          "sha256",
          "managed",
          "headings",
          "bullets"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Tool, e.g. eslint, ruff, codeowners."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Repository-relative POSIX path."
          },
          "facts": {
            "default": {},
            "description": "A few configuration facts, e.g. { strict: true }. Never file contents.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "maxLength": 40
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
            "description": "Unique, stable standard identifier, e.g. AUTH-017."
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "pack": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Where the rule comes from, e.g. groundrule:packs/python."
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "advisory",
              "warning",
              "blocker"
            ],
            "description": "info: context only. advisory: non-blocking recommendation. warning: visible, needs acknowledgment. blocker: fails the check."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "clean",
              "violations",
              "guidance",
              "not-applicable",
              "not-evaluable"
            ]
          },
          "findings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "filesInScope": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Files the rule looks at in this repository."
          },
          "filesAffected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Files with at least one finding."
          },
          "examples": {
            "default": [],
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "description": "Repository-relative POSIX path."
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "snippet": {
                  "description": "One line of code, secrets redacted. Omitted for secret-detection rules.",
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "message"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "version",
          "pack",
          "severity",
          "outcome",
          "findings",
          "filesInScope",
          "filesAffected"
        ],
        "additionalProperties": false
      }
    },
    "imports": {
      "description": "Existing instructions, tool settings, and owners, as proposals (RFC 0004). Omitted with --no-import.",
      "type": "object",
      "properties": {
        "instructions": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "section": {
                "description": "Heading path, e.g. Testing › Mocks.",
                "type": "string",
                "maxLength": 200
              },
              "strength": {
                "type": "string",
                "enum": [
                  "must",
                  "should",
                  "info"
                ]
              },
              "scope": {
                "description": "From Cursor globs or Copilot applyTo.",
                "type": "object",
                "properties": {
                  "paths": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                },
                "required": [
                  "paths"
                ],
                "additionalProperties": false
              },
              "sources": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400,
                      "description": "Repository-relative POSIX path."
                    },
                    "startLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endLine": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "file",
                    "startLine"
                  ],
                  "additionalProperties": false
                }
              },
              "similar": {
                "default": [],
                "description": "Catalog rules with similar wording (keyword match, not AI).",
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
                      "description": "Unique, stable standard identifier, e.g. AUTH-017."
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "id",
                    "score"
                  ],
                  "additionalProperties": false
                }
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Hash of the normalized text."
              }
            },
            "required": [
              "text",
              "strength",
              "sources",
              "fingerprint"
            ],
            "additionalProperties": false
          }
        },
        "toolSettings": {
          "maxItems": 300,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "setting": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "e.g. no-console, T201, strict."
              },
              "value": {
                "type": "string",
                "maxLength": 60,
                "description": "As configured, e.g. error, warn, off, true."
              },
              "stance": {
                "type": "string",
                "enum": [
                  "enforced",
                  "warned",
                  "disabled"
                ]
              },
              "standardId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-[0-9]+$",
                "description": "Unique, stable standard identifier, e.g. AUTH-017."
              },
              "source": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Repository-relative POSIX path."
                  },
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "file"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "tool",
              "setting",
              "value",
              "stance",
              "standardId",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "owners": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "owners": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "category": {
                "type": "string",
                "maxLength": 40
              },
              "repositoryDefault": {
                "type": "boolean",
                "description": "The catch-all entry (*), i.e. who owns the repository."
              },
              "source": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Repository-relative POSIX path."
                  },
                  "startLine": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endLine": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "file",
                  "startLine"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "pattern",
              "owners",
              "repositoryDefault",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "instructions",
        "toolSettings",
        "owners"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "clean": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "violations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "guidance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "notEvaluable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      },
      "required": [
        "rules",
        "clean",
        "violations",
        "guidance",
        "notApplicable",
        "notEvaluable",
        "findings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "repository",
    "stack",
    "agentFiles",
    "tools",
    "rules",
    "summary"
  ],
  "additionalProperties": false,
  "description": "A repository scan, produced by `groundrule scan` and uploaded with --upload."
}
