{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes '@groundrule/cli@0.24.1' hook claude-code --before-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes '@groundrule/cli@0.24.1' hook claude-code",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
