{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes '@groundrule/cli@>=0.17.0' hook claude-code --before-edit",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes '@groundrule/cli@>=0.4.0' hook claude-code",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
